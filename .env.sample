# Pigeonhole configuration. `make up` (or `make init`) copies this to .env,
# generates the two secrets and asks for your OpenRouter key. Everything below
# "Optional" has a working default.

# Your OpenRouter key: https://openrouter.ai/keys
# A decision model (Jev) answers classifications through OpenRouter's Decisions
# API; a reasoning model writes specs through chat completions. Both bill to
# this key.
OPENROUTER_API_KEY=

# Bearer token for the UI, the CLI and the control-plane API. Required.
PH_ADMIN_TOKEN=CHANGEME

# Password for the bundled Postgres. It publishes no port.
POSTGRES_PASSWORD=CHANGEME


# ── Optional ────────────────────────────────────────────────────────────────

# Models. A pipeline's spec can override both.
#   runtime:  a decision model — jev-latest, or a pinned version like typesafe/jev-1.13
#   compiler: any OpenRouter chat model that can reason; it only writes specs
PH_RUNTIME_MODEL=jev-latest
PH_COMPILER_MODEL=anthropic/claude-sonnet-5

# Where the app listens on the host. Loopback by default; put a TLS proxy in
# front before exposing it.
PH_BIND=127.0.0.1:8080

# The externally reachable URL, used in generated OpenAPI documents.
PH_PUBLIC_URL=http://localhost:8080

# debug | info | warn | error
LOG_LEVEL=info
