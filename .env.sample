# Pigeonhole configuration. `make up` (or `make init`) copies this to .env,
# generates the two secrets and asks for your OpenRouter key. Everything below
# "Optional" has a working default.

# Your OpenRouter key: https://openrouter.ai/keys
# A decision model (Jev) answers classifications through OpenRouter's Decisions
# API; a reasoning model writes specs through chat completions. Both bill to
# this key.
OPENROUTER_API_KEY=

# Bearer token for the UI, the CLI and the control-plane API. Required.
PH_ADMIN_TOKEN=CHANGEME

# Password for the bundled Postgres. It publishes no port.
POSTGRES_PASSWORD=CHANGEME


# ── Optional ────────────────────────────────────────────────────────────────

# Models. A pipeline's spec can override both.
#   runtime:  a decision model — jev-latest, or a pinned version like typesafe/jev-1.13;
#             or laya (or laya-english, laya-multilingual, laya-typed-decisions),
#             which runs locally: enable the Laya section below first
#   compiler: any OpenRouter chat model that can reason; it only writes specs
PH_RUNTIME_MODEL=jev-latest
PH_COMPILER_MODEL=anthropic/claude-sonnet-5

# Where the app listens on the host. Loopback by default; put a TLS proxy in
# front before exposing it.
PH_BIND=127.0.0.1:8080

# The externally reachable URL, used in generated OpenAPI documents.
PH_PUBLIC_URL=http://localhost:8080

# debug | info | warn | error
LOG_LEVEL=info


# ── Laya (optional, local) ──────────────────────────────────────────────────
# Laya is a decision model you run yourself: https://www.layaaimodel.com
# Uncomment the profile to add it to the stack; the first `make up` downloads
# about 1.5 GB of weights. See docs/laya.md.
#COMPOSE_PROFILES=laya

# On an NVIDIA GPU (needs the NVIDIA Container Toolkit), also uncomment:
#COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml

# Checkpoints built at startup: english, multilingual, typed-decisions.
#LAYA_MODELS=english,multilingual
# CPU threads for inference; keep at or below the physical core count.
#LAYA_THREADS=4

# Where the app finds Laya. The bundled service is the default; point this at
# http://host.docker.internal:8000 for a laya-serve running on the host.
#LAYA_URL=http://laya:8000
# Bearer token the Laya server requires, if any. The bundled one publishes no
# port, so it needs none.
#LAYA_API_KEY=
