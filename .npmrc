# Don't pick versions published in the last 3 days when npm resolves them
# (npm install/update, npm >= 11.10; older npm ignores it). Matches the
# Dependabot cooldown in .github/dependabot.yml. npm ci installs the lockfile
# as written and does not check this, so update the lockfile with npm >= 11.10.
min-release-age=3
