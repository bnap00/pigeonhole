{
  "name": "pigeonhole",
  "version": "0.1.0",
  "description": "Describe a classifier in English, get a typed, tested, versioned REST endpoint.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "pigeonhole": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:unit": "node --import tsx --test test/expr.test.ts test/spec.test.ts test/executor.test.ts test/evals.test.ts test/policy.test.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.1.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.2.2",
    "pg": "^8.14.1",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
